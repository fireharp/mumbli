{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Mumbli",
  "theme": "maple",
  "colors": {
    "primary": "#C8643C",
    "light": "#F2DDD0",
    "dark": "#8A3E20"
  },
  "appearance": {
    "default": "light"
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Newsreader",
      "weight": 400
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "background": {
    "color": {
      "light": "#F6F1E8",
      "dark": "#1F1B16"
    }
  },
  "favicon": "/waveform-icon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "topbar": {
    "links": [
      {
        "name": "Download",
        "url": "https://github.com/fireharp/mumbli/releases/latest"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "pages": [
          "index",
          {
            "group": "Using Mumbli",
            "pages": [
              "voice-to-text-for-mac",
              "dictation-app-for-mac",
              "works-in-any-app",
              "menu-bar-dictation-app",
              "custom-vocabulary-for-dictation",
              "privacy"
            ]
          },
          {
            "group": "Benchmarks",
            "pages": [
              "benchmarks"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "pages": [
          "for-developers",
          {
            "group": "Compare",
            "pages": ["compare/apple-dictation"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Changelog",
          "href": "/changelog",
          "icon": "clock-rotate-left"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/fireharp/mumbli",
          "icon": "github"
        }
      ]
    }
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "google-site-verification": "PLACEHOLDER",
      "msvalidate.01": "PLACEHOLDER"
    }
  },
  "footerSocials": {
    "github": "https://github.com/fireharp/mumbli"
  },
  "redirects": []
}
